<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<BorderPane style="-fx-background-color: #f8f9fa;" stylesheets="@Style.css" xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.RegisterController">

    <top>
        <VBox style="-fx-background-color: #2c3e50;">
            <HBox alignment="CENTER_LEFT" spacing="20.0">
                <padding>
                    <Insets bottom="8.0" left="20.0" right="20.0" top="12.0"/>
                </padding>
                <Label text="SĐT: 0834539363" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="13.0"/>
                    </font>
                </Label>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Email: 25020399@vnu.edu.vn" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="13.0"/>
                    </font>
                </Label>
            </HBox>
            <HBox alignment="CENTER">
                <padding>
                    <Insets bottom="12.0" left="20.0" right="20.0"/>
                </padding>
                <Label text="Địa chỉ: 144 Xuân Thủy, Dịch Vọng Hậu, Cầu Giấy, Hà Nội." textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="13.0"/>
                    </font>
                </Label>
            </HBox>
        </VBox>
    </top>

    <center>
        <StackPane BorderPane.alignment="CENTER">
            <children>
                <VBox alignment="CENTER" maxHeight="650.0" maxWidth="550.0" spacing="15.0"
                      style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 15, 0, 0, 5);"
                      stylesheets="@Style.css">
                    <padding>
                        <Insets bottom="30.0" left="50.0" right="50.0" top="20.0"/>
                    </padding>

                    <ImageView fitHeight="90.0" fitWidth="90.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                            <Image url="@Image/pngtree-auction-icon-png-image_8470662.png"/>
                        </image>
                    </ImageView>

                    <Label text="ĐĂNG KÝ TÀI KHOẢN" textFill="#2c3e50">
                        <font>
                            <Font name="System Bold" size="26.0"/>
                        </font>
                        <VBox.margin>
                            <Insets bottom="10.0"/>
                        </VBox.margin>
                    </Label>

                    <GridPane alignment="CENTER" hgap="15.0" vgap="12.0">
                        <columnConstraints>
                            <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES" maxWidth="150.0" minWidth="100.0"
                                               prefWidth="130.0"/>
                            <ColumnConstraints hgrow="SOMETIMES" maxWidth="250.0" minWidth="200.0" prefWidth="220.0"/>
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints minHeight="35.0" vgrow="SOMETIMES"/>
                            <RowConstraints minHeight="35.0" vgrow="SOMETIMES"/>
                            <RowConstraints minHeight="35.0" vgrow="SOMETIMES"/>
                            <RowConstraints minHeight="35.0" vgrow="SOMETIMES"/>
                            <RowConstraints minHeight="35.0" vgrow="SOMETIMES"/>
                            <RowConstraints minHeight="35.0" vgrow="SOMETIMES"/>
                        </rowConstraints>
                        <children>
                            <Label text="Tên đăng nhập:" textFill="#34495e">
                                <font>
                                    <Font size="14.0"/>
                                </font>
                            </Label>
                            <TextField fx:id="txtUsername" prefHeight="35.0" promptText="Từ 4-20 kí tự"
                                       style="-fx-background-radius: 5; -fx-border-color: #bdc3c7; -fx-border-radius: 5;"
                                       styleClass="text-input-modern" GridPane.columnIndex="1"/>

                            <Label text="Mật khẩu:" textFill="#34495e" GridPane.rowIndex="1">
                                <font>
                                    <Font size="14.0"/>
                                </font>
                            </Label>
                            <PasswordField fx:id="txtPass" prefHeight="35.0" promptText="Từ 8-30 kí tự"
                                           style="-fx-background-radius: 5; -fx-border-color: #bdc3c7; -fx-border-radius: 5;"
                                           styleClass="text-input-modern" GridPane.columnIndex="1"
                                           GridPane.rowIndex="1"/>

                            <Label text="Nhập lại mật khẩu:" textFill="#34495e" GridPane.rowIndex="2">
                                <font>
                                    <Font size="14.0"/>
                                </font>
                            </Label>
                            <PasswordField fx:id="txtPass2" prefHeight="35.0" promptText="Xác nhận mật khẩu"
                                           style="-fx-background-radius: 5; -fx-border-color: #bdc3c7; -fx-border-radius: 5;"
                                           styleClass="text-input-modern" GridPane.columnIndex="1"
                                           GridPane.rowIndex="2"/>

                            <Label text="Email:" textFill="#34495e" GridPane.rowIndex="3">
                                <font>
                                    <Font size="14.0"/>
                                </font>
                            </Label>
                            <TextField fx:id="txtEmail" prefHeight="35.0" promptText="abc@vnu.edu.vn"
                                       style="-fx-background-radius: 5; -fx-border-color: #bdc3c7; -fx-border-radius: 5;"
                                       styleClass="text-input-modern" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                            <Label text="Số điện thoại:" textFill="#34495e" GridPane.rowIndex="4">
                                <font>
                                    <Font size="14.0"/>
                                </font>
                            </Label>
                            <TextField fx:id="txtPhone" prefHeight="35.0" promptText="0123456789"
                                       style="-fx-background-radius: 5; -fx-border-color: #bdc3c7; -fx-border-radius: 5;"
                                       styleClass="text-input-modern" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                            <Label text="Vai trò:" textFill="#34495e" GridPane.rowIndex="5">
                                <font>
                                    <Font size="14.0"/>
                                </font>
                            </Label>
                            <ComboBox fx:id="cbRole" prefHeight="35.0" prefWidth="250.0" promptText="-- Chọn vai trò --"
                                      style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 5;"
                                      styleClass="text-input-modern" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
                        </children>
                    </GridPane>

                    <Label fx:id="lblERROR" textFill="#e74c3c">
                        <font>
                            <Font name="System Italic" size="13.0"/>
                        </font>
                    </Label>

                    <HBox alignment="CENTER" spacing="20.0">
                        <VBox.margin>
                            <Insets top="5.0"/>
                        </VBox.margin>
                        <Button fx:id="btnRegister1" mnemonicParsing="false" onAction="#RegisterLogic" prefHeight="40.0"
                                prefWidth="130.0"
                                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 5;"
                                styleClass="btn-primary" text="ĐĂNG KÝ"/>
                        <Button fx:id="btnOut" mnemonicParsing="false" onAction="#toWelcomeScreen" prefHeight="40.0"
                                prefWidth="130.0"
                                style="-fx-background-color: transparent; -fx-border-color: #95a5a6; -fx-text-fill: #7f8c8d; -fx-font-weight: bold; -fx-cursor: hand; -fx-border-radius: 5;"
                                styleClass="btn-primary" text="QUAY LẠI"/>
                    </HBox>

                    <HBox alignment="CENTER" spacing="5.0">
                        <VBox.margin>
                            <Insets top="10.0"/>
                        </VBox.margin>
                        <Label text="Đã có tài khoản?" textFill="#7f8c8d">
                            <font>
                                <Font size="14.0"/>
                            </font>
                        </Label>
                        <Button fx:id="btnSignIN" mnemonicParsing="false" onAction="#toSignInScreen"
                                style="-fx-background-color: transparent; -fx-text-fill: #2980b9; -fx-cursor: hand;"
                                stylesheets="@Style.css" text="Đăng nhập ngay">
                            <font>
                                <Font name="System Bold" size="14.0"/>
                            </font>
                            <padding>
                                <Insets bottom="0" left="0" right="0" top="0"/>
                            </padding>
                        </Button>
                    </HBox>
                </VBox>
            </children>
        </StackPane>
    </center>

    <bottom>
        <BorderPane style="-fx-background-color: white; -fx-border-color: #dee2e6; -fx-border-width: 1 0 0 0;">
            <padding>
                <Insets bottom="10.0" left="20.0" right="20.0" top="10.0"/>
            </padding>
            <right>
                <Label fx:id="lblTime4" text="Thời gian hiển thị tại đây" textFill="#7f8c8d"
                       BorderPane.alignment="CENTER">
                    <font>
                        <Font name="System Italic" size="13.0"/>
                    </font>
                </Label>
            </right>
        </BorderPane>
    </bottom>

</BorderPane>

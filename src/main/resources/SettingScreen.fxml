<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<BorderPane style="-fx-background-color: #f4f6f9;" xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.SettingController">

    <top>
        <VBox style="-fx-background-color: #2c3e50;" BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="20.0">
                    <padding>
                        <Insets bottom="5.0" left="20.0" right="20.0" top="10.0"/>
                    </padding>
                    <Label style="-fx-text-fill: white;" text="SĐT: 0834539363">
                        <font>
                            <Font name="System Bold" size="13.0"/>
                        </font>
                    </Label>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label style="-fx-text-fill: white;" text="Email: 25020399@vnu.edu.vn">
                        <font>
                            <Font name="System Bold" size="13.0"/>
                        </font>
                    </Label>
                </HBox>
                <HBox alignment="CENTER">
                    <padding>
                        <Insets bottom="10.0" left="20.0" right="20.0"/>
                    </padding>
                    <children>
                        <Label style="-fx-text-fill: white;"
                               text="Địa chỉ: 144 Xuân Thủy, Dịch Vọng Hậu, Cầu Giấy, Hà Nội.">
                            <font>
                                <Font name="System Bold" size="13.0"/>
                            </font>
                        </Label>
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>

    <center>
        <StackPane BorderPane.alignment="CENTER">
            <children>
                <VBox alignment="TOP_CENTER" maxHeight="600.0" maxWidth="700.0" spacing="10.0" stylesheets="@Style.css">
                    <padding>
                        <Insets bottom="10.0" left="30.0" right="30.0" top="20.0"/>
                    </padding>

                    <HBox alignment="CENTER_LEFT" spacing="15.0">
                        <ImageView fitHeight="45.0" fitWidth="45.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@Image/8f1ca2029e2efceebd22fa05cca423d7.jpg"/>
                            </image>
                        </ImageView>
                        <VBox alignment="CENTER_LEFT">
                            <Label style="-fx-text-fill: #2c3e50;" text="CÀI ĐẶT TÀI KHOẢN">
                                <font>
                                    <Font name="System Bold" size="22.0"/>
                                </font>
                            </Label>

                            <HBox alignment="CENTER_LEFT">
                                <Label fx:id="lblUsernameSettings" style="-fx-text-fill: #7f8c8d;"
                                       text="Đang đăng nhập: ">
                                    <font>
                                        <Font name="System Italic" size="14.0"/>
                                    </font>
                                </Label>
                                <Label fx:id="lblUsernameSettings1" style="-fx-text-fill: #7f8c8d;" text="Tên_User">
                                    <font>
                                        <Font name="System Italic" size="14.0"/>
                                    </font>
                                </Label>
                            </HBox>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnDeleteAccount" mnemonicParsing="false" onAction="#DeleteUser"
                                prefHeight="35.0"
                                style="-fx-background-color: transparent; -fx-border-color: #c0392b; -fx-text-fill: #c0392b; -fx-border-radius: 5; -fx-cursor: hand;"
                                styleClass="btn-primary" stylesheets="@Style.css" text=" Xóa tài khoản">
                            <font>
                                <Font name="System Bold" size="13.0"/>
                            </font>
                        </Button>
                    </HBox>

                    <VBox spacing="10.0"
                          style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 0);">
                        <Label style="-fx-text-fill: #34495e;" text="1. Thông tin liên hệ">
                            <font>
                                <Font name="System Bold" size="15.0"/>
                            </font>
                        </Label>

                        <GridPane hgap="15.0" vgap="10.0">
                            <columnConstraints>
                                <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES" minWidth="10.0"
                                                   prefWidth="120.0"/>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="250.0"/>
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="30.0" vgrow="SOMETIMES"/>
                                <RowConstraints minHeight="30.0" vgrow="SOMETIMES"/>
                                <RowConstraints minHeight="30.0" vgrow="SOMETIMES"/>
                                <RowConstraints minHeight="30.0" vgrow="SOMETIMES"/>
                            </rowConstraints>
                            <children>
                                <Label text="Tên hiển thị mới:" textFill="#7f8c8d">
                                    <font>
                                        <Font size="13.0"/>
                                    </font>
                                </Label>
                                <TextField fx:id="txtUpdateName" prefHeight="30.0" promptText="Nhập tên hiển thị mới"
                                           style="-fx-border-color: #bdc3c7; -fx-border-radius: 5;"
                                           styleClass="text-input-modern" GridPane.columnIndex="1"/>

                                <Label text="Email mới:" textFill="#7f8c8d" GridPane.rowIndex="1">
                                    <font>
                                        <Font size="13.0"/>
                                    </font>
                                </Label>
                                <TextField fx:id="txtUpdateEmail" prefHeight="30.0" promptText="Nhập email mới"
                                           style="-fx-border-color: #bdc3c7; -fx-border-radius: 5;"
                                           styleClass="text-input-modern" GridPane.columnIndex="1"
                                           GridPane.rowIndex="1"/>

                                <Label text="Số ĐT mới:" textFill="#7f8c8d" GridPane.rowIndex="2">
                                    <font>
                                        <Font size="13.0"/>
                                    </font>
                                </Label>
                                <TextField fx:id="txtUpdatePhone" prefHeight="30.0" promptText="Nhập số điện thoại mới"
                                           style="-fx-border-color: #bdc3c7; -fx-border-radius: 5;"
                                           styleClass="text-input-modern" GridPane.columnIndex="1"
                                           GridPane.rowIndex="2"/>

                                <Label fx:id="lblAddressTitle" text="Địa chỉ nhận hàng:" textFill="#7f8c8d"
                                       GridPane.rowIndex="3">
                                    <font>
                                        <Font size="13.0"/>
                                    </font>
                                </Label>
                                <TextField fx:id="txtUpdateAddress" prefHeight="30.0"
                                           promptText="Nhập địa chỉ giao hàng mới"
                                           style="-fx-border-color: #bdc3c7; -fx-border-radius: 5;"
                                           styleClass="text-input-modern" GridPane.columnIndex="1"
                                           GridPane.rowIndex="3"/>
                            </children>
                        </GridPane>

                        <HBox alignment="CENTER_LEFT">
                            <Label fx:id="lblSettingInfoError" style="-fx-text-fill: #e74c3c; -fx-font-style: italic;"
                                   text=""/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button fx:id="btnUpdateInfo" mnemonicParsing="false" onAction="#updateInfoLogic"
                                    prefHeight="32.0" prefWidth="120.0"
                                    style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 5;"
                                    styleClass="btn-primary" text="Lưu thông tin"/>
                        </HBox>
                    </VBox>

                    <Separator prefWidth="200.0" style="-fx-padding: -5 0 -5 0;"/>

                    <VBox spacing="10.0"
                          style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 0);">
                        <Label style="-fx-text-fill: #34495e;" text="2. Đổi mật khẩu">
                            <font>
                                <Font name="System Bold" size="15.0"/>
                            </font>
                        </Label>

                        <GridPane hgap="15.0" vgap="10.0">
                            <columnConstraints>
                                <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES" minWidth="10.0"
                                                   prefWidth="120.0"/>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="250.0"/>
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="30.0" vgrow="SOMETIMES"/>
                                <RowConstraints minHeight="30.0" vgrow="SOMETIMES"/>
                                <RowConstraints minHeight="30.0" vgrow="SOMETIMES"/>
                            </rowConstraints>
                            <children>
                                <Label text="Mật khẩu hiện tại:" textFill="#7f8c8d">
                                    <font>
                                        <Font size="13.0"/>
                                    </font>
                                </Label>
                                <PasswordField fx:id="txtOldPass" prefHeight="30.0" promptText="Nhập mật khẩu cũ"
                                               style="-fx-border-color: #bdc3c7; -fx-border-radius: 5;"
                                               styleClass="text-input-modern" GridPane.columnIndex="1"/>

                                <Label text="Mật khẩu mới:" textFill="#7f8c8d" GridPane.rowIndex="1">
                                    <font>
                                        <Font size="13.0"/>
                                    </font>
                                </Label>
                                <PasswordField fx:id="txtNewPass" prefHeight="30.0" promptText="Nhập mật khẩu mới"
                                               style="-fx-border-color: #bdc3c7; -fx-border-radius: 5;"
                                               styleClass="text-input-modern" GridPane.columnIndex="1"
                                               GridPane.rowIndex="1"/>

                                <Label text="Xác nhận lại:" textFill="#7f8c8d" GridPane.rowIndex="2">
                                    <font>
                                        <Font size="13.0"/>
                                    </font>
                                </Label>
                                <PasswordField fx:id="txtConfirmNewPass" prefHeight="30.0"
                                               promptText="Xác nhận mật khẩu mới"
                                               style="-fx-border-color: #bdc3c7; -fx-border-radius: 5;"
                                               styleClass="text-input-modern" GridPane.columnIndex="1"
                                               GridPane.rowIndex="2"/>
                            </children>
                        </GridPane>

                        <HBox alignment="CENTER_LEFT">
                            <Label fx:id="lblChangePassError" style="-fx-text-fill: #e74c3c; -fx-font-style: italic;"
                                   text=""/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button fx:id="btnChangePass" mnemonicParsing="false" onAction="#changePassLogic"
                                    prefHeight="32.0" prefWidth="120.0"
                                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 5;"
                                    styleClass="btn-primary" text="Đổi mật khẩu"/>
                        </HBox>
                    </VBox>

                    <Label fx:id="lblSettingsMessage" style="-fx-text-fill: #27ae60; -fx-font-weight: bold;" text=" "/>

                </VBox>
            </children>
        </StackPane>
    </center>

    <bottom>
        <StackPane prefHeight="0.0" prefWidth="650.0"
                   style="-fx-background-color: white; -fx-border-color: #dee2e6; -fx-border-width: 1 0 0 0;">
            <padding>
                <Insets bottom="10.0" left="20.0" right="20.0" top="10.0"/>
            </padding>
            <children>
                <Label fx:id="lblTime6" style="-fx-text-fill: #7f8c8d;" text="Thời gian hiển thị tại đây"
                       StackPane.alignment="CENTER">
                    <font>
                        <Font name="System Italic" size="14.0"/>
                    </font>
                </Label>
                <Button fx:id="btnBackFromSettings" mnemonicParsing="false" onAction="#toPreviousScreen"
                        prefHeight="35.0" prefWidth="110.0"
                        style="-fx-background-color: transparent; -fx-border-color: #95a5a6; -fx-text-fill: #7f8c8d; -fx-border-radius: 5; -fx-font-weight: bold; -fx-cursor: hand;"
                        styleClass="btn-primary" stylesheets="@Style.css" text="Quay lại"
                        StackPane.alignment="CENTER_RIGHT"/>
            </children>
        </StackPane>
    </bottom>

</BorderPane>

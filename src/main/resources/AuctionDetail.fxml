                                                    <Button fx:id="btnAutoBid" mnemonicParsing="false" onAction="#onAutoBidButtonClicked" prefHeight="35.0" prefWidth="90.0" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 5;" styleClass="btn-primary" text="Cài Auto">

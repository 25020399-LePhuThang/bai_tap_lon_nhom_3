                                                <font>
                                                    <Font size="15.0" />
                                                </font>
                                            </Label>

                                            <Label text="ID sản phẩm:" textFill="#7f8c8d" GridPane.rowIndex="1">
                                                <font>
                                                    <Font name="System Bold" size="14.0" />
                                                </font>
                                            </Label>
                                            <Label fx:id="lblProductID" text="Đang tải..." textFill="#2c3e50" GridPane.columnIndex="1" GridPane.rowIndex="1">
